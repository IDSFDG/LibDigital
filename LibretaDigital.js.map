    Panel1.Width := 640;
    Panel1.Height := 60;
    Panel1.ElementClassName := 'card';
    Panel1.ElementBodyClassName := 'card-body';
    Panel1.ElementFont := efCSS;
    Panel1.TabOrder := 0;
    Panel1.Visible := False;
    WebButton1.SetParentComponent(Panel1);
    WebButton1.Name := 'WebButton1';
