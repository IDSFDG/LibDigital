    divSunEditor: THTMLDiv;
    WebButton1: TButton;
    WebPanelBottom: TPanel;
    WebButton3: TButton;
    WebButton2: TButton;
    btnfocus: TButton;
    procedure WebFormCreate(Sender: TObject);
    procedure btnCodeMirrorBoldClick(Sender: TObject);
    procedure btnCodeMirrorUnderlineClick(Sender: TObject);
    procedure btnCodeMirrorItalicClick(Sender: TObject);
    procedure SummernoteSave(HTML:WideString);
    procedure SunEditorSave(HTML:WideString);
    procedure btnCodeMirrorSaveClick(Sender: TObject);
    procedure WebPanelBottomClick(Sender: TObject);
    procedure WebLabel1Click(Sender: TObject);
    procedure WebButton1Click(Sender: TObject);
    procedure WebButton2Click(Sender: TObject);
    procedure WebButton3Click(Sender: TObject);
    procedure btnfocusClick(Sender: TObject);
    procedure WebFormShow(Sender: TObject);
    procedure WebFormResize(Sender: TObject);
