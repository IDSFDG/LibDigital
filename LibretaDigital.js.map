  WebScrollBox1.BeforeLoadDFMValues;
  btnRenglones.BeforeLoadDFMValues;
  btnTabular.BeforeLoadDFMValues;
  btnEditor.BeforeLoadDFMValues;
  btnSalir.BeforeLoadDFMValues;
