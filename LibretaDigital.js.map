    WebHTMLDiv1.Width := 640;
    WebHTMLDiv1.Height := 227;
    WebHTMLDiv1.Align := alClient;
    WebHTMLDiv1.ChildOrder := 1;
    WebHTMLDiv1.ElementPosition := epRelative;
    WebHTMLDiv1.ElementFont := efCSS;
