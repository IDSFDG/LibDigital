procedure TfrmEditor.LoadDFMValues;
begin
  inherited LoadDFMValues;

  divSunEditor := THTMLDiv.Create('divSunEditor');
  WebButton1 := TButton.Create(Self);
  WebPanelBottom := TPanel.Create(Self);
  WebButton3 := TButton.Create(Self);
  WebButton2 := TButton.Create(Self);
  btnfocus := TButton.Create(Self);

  divSunEditor.BeforeLoadDFMValues;
  WebButton1.BeforeLoadDFMValues;
  WebPanelBottom.BeforeLoadDFMValues;
  WebButton3.BeforeLoadDFMValues;
  WebButton2.BeforeLoadDFMValues;
  btnfocus.BeforeLoadDFMValues;
  try
    Name := 'frmEditor';
    Width := 600;
    Height := 960;
    Color := clSilver;
    CSSLibrary := cssBootstrap;
    ElementFont := efCSS;
    Font.Charset := DEFAULT_CHARSET;
    Font.Color := clWindowText;
    Font.Height := -15;
    Font.Name := 'Tahoma';
    Font.Style := [];
    ParentFont := False;
    SetEvent(Self, 'OnCreate', 'WebFormCreate');
    SetEvent(Self, 'OnResize', 'WebFormResize');
    SetEvent(Self, 'OnShow', 'WebFormShow');
    divSunEditor.SetParentComponent(Self);
    divSunEditor.Name := 'divSunEditor';
    divSunEditor.Left := 8;
    divSunEditor.Top := 39;
    divSunEditor.Width := 584;
    divSunEditor.Height := 192;
    divSunEditor.ChildOrder := 1;
    divSunEditor.ElementPosition := epIgnore;
    divSunEditor.ElementFont := efCSS;
    divSunEditor.Role := '';
    WebButton1.SetParentComponent(Self);
    WebButton1.Name := 'WebButton1';
    WebButton1.Left := 0;
    WebButton1.Top := 935;
    WebButton1.Width := 600;
    WebButton1.Height := 25;
    WebButton1.Align := alBottom;
    WebButton1.Caption := 'Salir';
    WebButton1.ChildOrder := 4;
    WebButton1.ElementClassName := 'btn btn-light';
    WebButton1.ElementFont := efCSS;
    WebButton1.HeightStyle := ssAuto;
    WebButton1.HeightPercent := 100.000000000000000000;
    WebButton1.Visible := False;
    WebButton1.WidthPercent := 100.000000000000000000;
    SetEvent(WebButton1, Self, 'OnClick', 'WebButton1Click');
    WebPanelBottom.SetParentComponent(Self);
    WebPanelBottom.Name := 'WebPanelBottom';
    WebPanelBottom.Left := 0;
    WebPanelBottom.Top := 896;
    WebPanelBottom.Width := 600;
    WebPanelBottom.Height := 39;
    WebPanelBottom.ElementClassName := 'card text-white bg-secondary mb-3';
    WebPanelBottom.Align := alBottom;
    WebPanelBottom.Caption := 'Salir';
    WebPanelBottom.ChildOrder := 4;
    WebPanelBottom.ElementBodyClassName := 'card-body';
    WebPanelBottom.ElementFont := efCSS;
    WebPanelBottom.TabOrder := 2;
    SetEvent(WebPanelBottom, Self, 'OnClick', 'WebPanelBottomClick');
    WebButton3.SetParentComponent(WebPanelBottom);
    WebButton3.Name := 'WebButton3';
    WebButton3.Left := 112;
    WebButton3.Top := 5;
    WebButton3.Width := 96;
    WebButton3.Height := 17;
    WebButton3.Caption := 'Hide';
    WebButton3.ChildOrder := 3;
    WebButton3.ElementClassName := 'btn btn-light';
    WebButton3.ElementFont := efCSS;
    WebButton3.HeightStyle := ssAuto;
    WebButton3.HeightPercent := 100.000000000000000000;
    WebButton3.Visible := False;
    WebButton3.WidthPercent := 100.000000000000000000;
    SetEvent(WebButton3, Self, 'OnClick', 'WebButton3Click');
    WebButton2.SetParentComponent(WebPanelBottom);
    WebButton2.Name := 'WebButton2';
    WebButton2.Left := 214;
    WebButton2.Top := 3;
    WebButton2.Width := 96;
    WebButton2.Height := 17;
    WebButton2.Caption := 'Show';
    WebButton2.ChildOrder := 2;
    WebButton2.ElementClassName := 'btn btn-light';
    WebButton2.ElementFont := efCSS;
    WebButton2.HeightStyle := ssAuto;
    WebButton2.HeightPercent := 100.000000000000000000;
    WebButton2.Visible := False;
    WebButton2.WidthPercent := 100.000000000000000000;
    SetEvent(WebButton2, Self, 'OnClick', 'WebButton2Click');
    btnfocus.SetParentComponent(WebPanelBottom);
    btnfocus.Name := 'btnfocus';
    btnfocus.Left := 3;
    btnfocus.Top := 3;
    btnfocus.Width := 96;
    btnfocus.Height := 25;
    btnfocus.Caption := 'focus';
    btnfocus.ChildOrder := 2;
    btnfocus.ElementClassName := 'btn btn-light';
    btnfocus.ElementFont := efCSS;
    btnfocus.HeightStyle := ssAuto;
    btnfocus.HeightPercent := 100.000000000000000000;
    btnfocus.Visible := False;
    btnfocus.WidthPercent := 100.000000000000000000;
    SetEvent(btnfocus, Self, 'OnClick', 'btnfocusClick');
  finally
    divSunEditor.AfterLoadDFMValues;
    WebButton1.AfterLoadDFMValues;
    WebPanelBottom.AfterLoadDFMValues;
    WebButton3.AfterLoadDFMValues;
    WebButton2.AfterLoadDFMValues;
    btnfocus.AfterLoadDFMValues;
  end;
end;

end.