unit uRichEditor;

interface

uses
  System.SysUtils, System.Classes, JS, Web, WEBLib.Graphics, WEBLib.Controls,
  WEBLib.Forms, WEBLib.Dialogs, WEBLib.ComCtrls, WEBLib.Buttons, Vcl.Controls,
  WEBLib.WebCtrls, WEBLib.ExtCtrls;

type
  TfrmRichEditor = class(TForm)
    WebHTMLDiv1: THTMLDiv;
    WebRichEditToolBar1: TRichEditToolBar;
    WebHTMLDiv2: THTMLDiv;
    WebRichEdit1: TRichEdit;
  private
    { Private declarations }
  public
    { Public declarations }
  protected procedure LoadDFMValues; override; end;

var
  frmRichEditor: TfrmRichEditor;

implementation

{$R *.dfm}

procedure TfrmRichEditor.LoadDFMValues;
begin
  inherited LoadDFMValues;

  WebHTMLDiv1 := THTMLDiv.Create(Self);
  WebRichEditToolBar1 := TRichEditToolBar.Create('');
  WebHTMLDiv2 := THTMLDiv.Create(Self);
  WebRichEdit1 := TRichEdit.Create(Self);

  WebHTMLDiv1.BeforeLoadDFMValues;
  WebRichEditToolBar1.BeforeLoadDFMValues;
  WebHTMLDiv2.BeforeLoadDFMValues;
  WebRichEdit1.BeforeLoadDFMValues;
  try
    Name := 'frmRichEditor';
    Width := 640;
    Height := 480;
    CSSLibrary := cssBootstrap;
    ElementFont := efCSS;
    Font.Charset := DEFAULT_CHARSET;
    Font.Color := clWindowText;
    Font.Height := -15;
    Font.Name := 'Tahoma';
    Font.Style := [];
    ParentFont := False;
    WebHTMLDiv1.SetParentComponent(Self);
    WebHTMLDiv1.Name := 'WebHTMLDiv1';
    WebHTMLDiv1.Left := 0;
    WebHTMLDiv1.Top := 0;
    WebHTMLDiv1.Width := 640;
    WebHTMLDiv1.Height := 41;
    WebHTMLDiv1.Align := alTop;
    WebHTMLDiv1.ElementFont := efCSS;
    WebHTMLDiv1.Role := '';
    WebRichEditToolBar1.SetParentComponent(WebHTMLDiv1);
    WebRichEditToolBar1.Name := 'WebRichEditToolBar1';
    WebRichEditToolBar1.Left := 0;
    WebRichEditToolBar1.Top := 0;
    WebRichEditToolBar1.Width := 640;
    WebRichEditToolBar1.Height := 41;
    WebRichEditToolBar1.ElementClassName := '';
    WebRichEditToolBar1.Align := alClient;
    WebRichEditToolBar1.Hints.BeginUpdate;
    try
      WebRichEditToolBar1.Hints.Clear;
      WebRichEditToolBar1.Hints.Add('Bold');
      WebRichEditToolBar1.Hints.Add('Italic');
      WebRichEditToolBar1.Hints.Add('Underline');
      WebRichEditToolBar1.Hints.Add('Strike Throught');
      WebRichEditToolBar1.Hints.Add('Text Color');
      WebRichEditToolBar1.Hints.Add('Background Color');
      WebRichEditToolBar1.Hints.Add('Align left');
      WebRichEditToolBar1.Hints.Add('Align center');
      WebRichEditToolBar1.Hints.Add('Align right');
      WebRichEditToolBar1.Hints.Add('Numbered list');
      WebRichEditToolBar1.Hints.Add('List');
      WebRichEditToolBar1.Hints.Add('Hyperlink');
      WebRichEditToolBar1.Hints.Add('Insert Image');
      WebRichEditToolBar1.Hints.Add('Line spacing');
    finally
      WebRichEditToolBar1.Hints.EndUpdate;
    end;
    WebRichEditToolBar1.RichEdit := WebRichEdit1;
    WebHTMLDiv2.SetParentComponent(Self);
    WebHTMLDiv2.Name := 'WebHTMLDiv2';
    WebHTMLDiv2.Left := 0;
    WebHTMLDiv2.Top := 41;
    WebHTMLDiv2.Width := 640;
    WebHTMLDiv2.Height := 439;
    WebHTMLDiv2.Align := alClient;
    WebHTMLDiv2.ChildOrder := 1;
    WebHTMLDiv2.ElementFont := efCSS;
    WebHTMLDiv2.Role := '';
    WebRichEdit1.SetParentComponent(WebHTMLDiv2);
    WebRichEdit1.Name := 'WebRichEdit1';
    WebRichEdit1.Left := 0;
    WebRichEdit1.Top := 0;
    WebRichEdit1.Width := 640;
    WebRichEdit1.Height := 439;
    WebRichEdit1.Align := alClient;
    WebRichEdit1.AutoSize := True;
    WebRichEdit1.BorderStyle := bsSingle;
    WebRichEdit1.Color := clWhite;
  finally
    WebHTMLDiv1.AfterLoadDFMValues;
    WebRichEditToolBar1.AfterLoadDFMValues;
    WebHTMLDiv2.AfterLoadDFMValues;
    WebRichEdit1.AfterLoadDFMValues;
  end;
end;

end.
