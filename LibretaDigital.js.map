  vsuneditor: JSValue;
implementation

{$R *.dfm}

procedure TfrmEditor.btnCodeMirrorBoldClick(Sender: TObject);
var
  cm: JSValue;
begin
  cm := frmEditor.cmeditor;
  asm
    var selection = cm.getSelection();
    cm.replaceSelection('**' + selection + '**');
    if (!selection) {
      var cursorPos =cm.getCursor();
      cm.setCursor(cursorPos.line, cursorPos.ch - 2);
    }
  end;
end;

procedure TfrmEditor.btnCodeMirrorItalicClick(Sender: TObject);
var
  cm: JSValue;
begin
  cm := frmEditor.cmeditor;
  asm
    var selection = cm.getSelection();
    cm.replaceSelection('*' + selection + '*');
    if (!selection) {
      var cursorPos =cm.getCursor();
      cm.setCursor(cursorPos.line, cursorPos.ch - 2);
    }
  end;
end;

procedure TfrmEditor.btnCodeMirrorSaveClick(Sender: TObject);
var
  cm: JSValue;  // CodeMirror Instance
  se: JSValue;  // SunEditor Instance;
begin
  cm := frmEditor.cmeditor;
  se := frmEditor.suneditor;
  asm
    var markdown = cm.getValue();
    var converter = new showdown.Converter();
    var html = converter.makeHtml(markdown);
    $("#divSummernote").summernote('code',html);
 //   se.setContents(html);
  end;

end;

procedure TfrmEditor.btnCodeMirrorUnderlineClick(Sender: TObject);
var
  cm: JSValue;
begin
  cm := frmEditor.cmeditor;
  asm
    var selection = cm.getSelection();
    cm.replaceSelection('<span style="text-decoration: underline">' + selection + '</span>');
    if (!selection) {
      var cursorPos =cm.getCursor();
      cm.setCursor(cursorPos.line, cursorPos.ch - 2);
    }
  end;
end;

procedure TfrmEditor.btnfocusClick(Sender: TObject);
var
  se: JSValue;
begin
    console.log('editorfocus',vsuneditor);
    se := vsuneditor;
   asm
     console.log(se.core);
     se.core.focus();
   end;

end;

