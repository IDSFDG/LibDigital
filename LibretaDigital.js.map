program LibretaDigital;

{$R *.dres}

uses
  Vcl.Forms,
  WEBLib.Forms,
  uFormaMenu in 'uFormaMenu.pas'{*.html},
  uLibretaResponsiveT in 'uLibretaResponsiveT.pas',
  editorDiv in 'editorDiv.pas'{*.html},
  uRichEditor in 'uRichEditor.pas'{*.html},
  uEditor in 'uEditor.pas'{*.html},
  uLibretaResponsive in 'uLibretaResponsive.pas',
  uLibretaResponsiveR in 'uLibretaResponsiveR.pas';

{$R *.res}

begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;

  asm
     window.history.pushState(null, '', 'LibretaDigital.html#frmMenu')
  end;

   Application.AutoFormRoute := True;
  Application.CreateForm(TfrmMenu, frmMenu);
  Application.Run;
end.
